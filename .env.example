# Copy this file to .env.local for local dev, and add the same values to
# your Vercel project settings (Settings -> Environment Variables).
#
# Server-side only. Never prefix these with VITE_ : VITE_ variables are
# embedded in the public browser bundle.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-random-password
# Long random string used to sign admin session tokens (e.g. `openssl rand -hex 32`)
SESSION_SECRET=generate-a-long-random-string

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
